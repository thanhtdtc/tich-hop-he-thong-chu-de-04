# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# PostgreSQL (dùng chung cho 2 CSDL trong docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=doi_mat_khau_o_day

# Địa chỉ Portal gọi tới (trong Docker dùng tên service, không dùng localhost)
ACADEMIC_URL=http://academic-api:8081
FINANCE_URL=http://finance-api:8082

# Chỉ dùng để kiểm thử timeout: 0 = bình thường, 5000 = Finance chậm 5 giây
FINANCE_DELAY_MS=0
